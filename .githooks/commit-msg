#!/bin/sh
# Checks the message against vendor/grado-factorio-tools/docs/commit-convention.md.
#
# This repository's own, beside the first .EXAMPLE of commit-check.ps1 that the rest is held to
# (#415): the scopes are commit-scopes.txt, and scripts/member-change-check.ps1 (#375) runs after
# the shared check, which therefore ends in `|| exit 1` where the example has `exec`. It refuses a
# commit that gains or loses a pack member with no ! before the subject's colon: what counts as
# breaking is this repository's own rule. The two lines that say what was NOT checked name the
# member changes too, as neither check runs there.
#
# INSTALL, twice per clone, because git tracks neither .git/hooks nor a submodule's contents:
#
#     git submodule update --init
#     git config core.hooksPath .githooks
#
# The message file survives a rejection, so `git commit -e -F .git/COMMIT_EDITMSG` reopens what you
# typed rather than making you write it again.
if ! command -v pwsh >/dev/null 2>&1; then
    echo "commit-msg: pwsh not found, so the message format and its member changes were NOT checked." >&2
    exit 0
fi
ROOT="$(git rev-parse --show-toplevel)"
CHECK="$ROOT/vendor/grado-factorio-tools/scripts/commit-check.ps1"
if [ ! -f "$CHECK" ]; then
    echo "commit-msg: $CHECK not found, so the message format and its member changes were NOT checked." >&2
    echo "commit-msg: run 'git submodule update --init' to fetch the shared check." >&2
    exit 0
fi
pwsh -NoProfile -File "$CHECK" -ScopeFile "$ROOT/commit-scopes.txt" "$1" || exit 1
exec pwsh -NoProfile -File "$ROOT/scripts/member-change-check.ps1" -MessageFile "$1"
