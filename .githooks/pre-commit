#!/bin/sh
# Checks the staged Markdown files for emphasis or a code span left open, a ragged table row and a
# link to a file that is not tracked (#149), and the staged scripts for a comment header line
# over 100 characters (#211). What each reads as what, and what it cannot see, is in the header
# of scripts/markdown-check.ps1 and of scripts/header-length-check.ps1; this is only the wiring.
#
# INSTALL, once per clone, the same line that wires up commit-msg:
#
#     git config core.hooksPath .githooks
#
# pwsh is what every other script here needs. If it is missing, say so and let the commit through,
# as commit-msg does, and never pass in silence.
if ! command -v pwsh >/dev/null 2>&1; then
    echo "pre-commit: pwsh not found, so the staged Markdown and scripts were NOT checked." >&2
    exit 0
fi

# Both run, so one commit shows what both found.
root="$(git rev-parse --show-toplevel)"
status=0
pwsh -NoProfile -File "$root/scripts/markdown-check.ps1" || status=1
pwsh -NoProfile -File "$root/scripts/header-length-check.ps1" || status=1
exit $status
